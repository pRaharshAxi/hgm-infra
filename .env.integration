# App
NODE_ENV=production
PORT_A=3001
PORT_B=3002

# PostgreSQL (System A)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=hgm_user
DB_PASSWORD=hgm_password
DB_NAME=hgm_system_a

# JWT (same secret both systems)
JWT_SECRET=super_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# MongoDB (System B)
MONGODB_URI=mongodb://mongodb:27017/hgm_system_b

# Elasticsearch (System B)
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=hgm_elastic_password

# RabbitMQ (both)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Redis (both)
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO (System A)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hgm-images
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=hgm-images

# Stripe (System B)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Frontend URL
FRONTEND_URL=http://localhost